        <item>
        <title>树莓血芭｜01｜主流奖项与恐怖片</title>
        <link>https://kelpfulblog.org/p/%E6%A0%91%E8%8E%93%E8%A1%80%E8%8A%AD01%E4%B8%BB%E6%B5%81%E5%A5%96%E9%A1%B9%E4%B8%8E%E6%81%90%E6%80%96%E7%89%87/</link>
